# Copy this file to .env and fill in real values before running.

# PostgreSQL via asyncpg driver
DATABASE_URL=postgresql+asyncpg://godown_user:CHANGE_ME@localhost:5432/godown_db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_64_CHAR_RANDOM_STRING

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false
