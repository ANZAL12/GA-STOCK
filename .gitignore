# ==============================================================================
# Global Agencies - Godown Management System
# Git Ignore Configuration
# ==============================================================================

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
~$*
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Environment & Secrets (NEVER COMMIT) ---
.env
*.env.local
*.env.*.local
!*.env.example

# --- Python & Backend (FastAPI / SQLAlchemy / Alembic) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/venv/
backend/env/
.venv/
venv/
env/
ENV/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend (React / Vite) ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/
frontend/.vite/
frontend/dist/

# --- Flutter & Mobile (Android / iOS) ---
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/

# Android Specific
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/app/build/
mobile/android/.idea/
mobile/android/*.iml
mobile/android/captures/
mobile/android/gradle/wrapper/gradle-wrapper.jar

# Binaries & APK Packages
*.apk
*.aab
*.ipa

# --- Database Dumps & Backups ---
backups/*.sql
backups/*.dump
backups/*.tar
*.sqlite3
*.db

# --- Logs & Temporary Files ---
*.log
logs/
temp/
tmp/
*.tmp
